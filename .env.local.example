# ─────────────────────────────────────────────────────────────
# Ferry — Environment Configuration (Stellar Testnet)
# Copy this file to `.env.local` and adjust as needed.
# Never commit `.env.local` or any file containing real secrets.
# ─────────────────────────────────────────────────────────────

# Stellar network (Testnet only for this project)
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Home domain of this application, presented to anchors during
# SEP-10 Web Authentication (must match the domain Ferry is served from).
NEXT_PUBLIC_HOME_DOMAIN=localhost:3000

# Default test anchor used for SEP-24 / SEP-31 / SEP-38 flows.
# The anchor's home domain must expose /.well-known/stellar.toml (SEP-1)
# with WEB_AUTH_ENDPOINT, TRANSFER_SERVER_SEP0024, DIRECT_PAYMENT_SERVER
# and ANCHOR_QUOTE_SERVER entries.
NEXT_PUBLIC_ANCHOR_DOMAIN=testanchor.stellar.org

# Base URL of this app (used for server-side API route calls, callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated domains the server will resolve/proxy at all (SSRF
# guard) — server-only, not NEXT_PUBLIC. Defaults to testanchor.stellar.org
# if unset. To run the EUR(EURC)->TRY corridor against the local mock
# anchor (mock-anchor/ — see its README, since no public TRY-issuing
# anchor exists on Testnet), set this to include localhost:4001 and set
# NEXT_PUBLIC_ANCHOR_DOMAIN=localhost:4001 above. See docs/RUNBOOK.md §2.
# ANCHOR_ALLOWLIST=testanchor.stellar.org,localhost:4001

# Override the EURC / mock-TRY asset issuers used to build SEP-38/31 asset
# identifiers. Leave unset to use Circle's real, verified Testnet EURC
# issuer and this repo's default mock TRY issuer — see
# CORRIDOR_VERIFICATION.md §5 before changing either.
# NEXT_PUBLIC_EURC_ISSUER=GB3Q6QDZYTHWT7E5PVS3W7FUT5GVAFC5KSZFFLPU25GO7VTC3NM2ZTVO
# NEXT_PUBLIC_MOCK_TRY_ISSUER=GADBO465IHRW3WNOCNM7H5UEXKER4TGT2FSBYUDHMKFOAYR2YHAQ72FZ

# ─────────────────────────────────────────────────────────────
# Security note: Ferry is strictly non-custodial. It never stores,
# requests, or transmits private keys / secret seeds. All signing
# happens client-side via the Freighter wallet extension.
# ─────────────────────────────────────────────────────────────
